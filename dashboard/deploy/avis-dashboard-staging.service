[Unit]
Description=AVIS Dashboard (staging)
After=network.target

[Service]
Type=simple
User=jabilie
WorkingDirectory=/opt/avis-dashboard-staging/dashboard
ExecStart=/opt/avis-dashboard-staging/dashboard/node_modules/.bin/next start -p 3231
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
