# Copy to .env.local on the Pi and fill in.

# Signs the AVIS session cookie. Long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# First sign-in with this NTID becomes Admin (only while no Admin exists).
BOOTSTRAP_ADMIN_NTID=4375789

# Shared secret the AVIS middleware on each station PC sends (its AVIS_DASHBOARD_KEY env var).
# Long random string, e.g. `openssl rand -hex 24`.
AVIS_STATION_KEY=

# App Hub on this Pi (SSO + app switcher). Only change if App Hub moves.
APP_HUB_URL=http://10.77.193.155:4001
NEXT_PUBLIC_APP_HUB_URL=http://10.77.193.155:4001
# Only if App Hub is ever given a real AUTH_COOKIE_SECRET - must match it.
# APP_HUB_AUTH_COOKIE_SECRET=

# Where data/ lives (default: ./data next to the app).
# AVIS_DATA_DIR=/opt/avis-dashboard/dashboard/data

# Set to allow an Approver to approve their own upload (default: a second person must approve).
# AVIS_ALLOW_SELF_APPROVAL=1
