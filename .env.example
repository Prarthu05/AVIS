# iFactory StackTest Gateway service-account credentials (NOT needed for the
# "AVIS (Simulation)" launch profile).
# Copy this file to .env for local bench testing (loaded automatically at
# startup). On the station PC, set these as real Windows environment
# variables instead - see README.md.
IFACTORY_USERNAME=Jabil\SVCCVG_JABILEYE
IFACTORY_PASSWORD=changeme

# AVIS dashboard (Raspberry Pi) shared station key - only needed when
# Dashboard:Enabled is true in appsettings.json. Must equal AVIS_STATION_KEY
# in the dashboard's .env.local.
AVIS_DASHBOARD_KEY=changeme
